{
  "$id": "https://nova.invalid/simulation/profile/0.1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "characteristics": {
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "boolean",
          "string",
          "null"
        ]
      },
      "minProperties": 1,
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile_version": {
      "const": "0.1"
    }
  },
  "required": [
    "profile_version",
    "name",
    "characteristics"
  ],
  "title": "Nova simulation characteristic profile",
  "type": "object"
}
