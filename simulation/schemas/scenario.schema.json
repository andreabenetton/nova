{
  "$id": "https://nova.invalid/simulation/scenario/0.2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clock": {
      "const": "virtual"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "action": {
            "type": "string"
          },
          "at_ms": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "at_ms",
          "action"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "identity": {
            "additionalProperties": false,
            "properties": {
              "address_digest_hex": {
                "pattern": "^[0-9a-fA-F]+$",
                "type": "string"
              },
              "cryptographic_suite_id": {
                "minimum": 0,
                "type": "integer"
              },
              "identity_digest_hex": {
                "pattern": "^[0-9a-fA-F]+$",
                "type": "string"
              },
              "identity_profile_id": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "identity_profile_id",
              "identity_digest_hex",
              "cryptographic_suite_id",
              "address_digest_hex"
            ],
            "type": "object"
          },
          "obfuscated_degree": {
            "additionalProperties": false,
            "properties": {
              "profile_id": {
                "minimum": 0,
                "type": "integer"
              },
              "valid_for_ms": {
                "minimum": 1,
                "type": "integer"
              },
              "value": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "value",
              "profile_id",
              "valid_for_ms"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "identity",
          "obfuscated_degree"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "paths": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "from": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "profile"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provider_compliance": {
      "enum": [
        "conforming",
        "intentionally-violating"
      ]
    },
    "schema_version": {
      "const": "0.2"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "seed",
    "clock",
    "nodes",
    "paths",
    "events"
  ],
  "title": "Nova deterministic simulation scenario 0.2",
  "type": "object"
}
